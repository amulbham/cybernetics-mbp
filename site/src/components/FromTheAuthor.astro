---
// Sprint 12.1 — Reader Context's one human-facing surface. Its job is
// exactly two things: render readerNote.why, render readerNote.for.
// Nothing else — no author bio, ORCID, correspondence, DOI, publication
// date, relations, IWL status, disclosures, funding, or AI-use statements.
// Those already have separate homes (ArticleMasthead, AuthorNote,
// authored `## Declarations`, the relation-projection layer).
//
// No optional-state handling here: ResearchLayout.astro only renders this
// component at all when `readerNote` exists, and content.config.ts's
// `.strict()` schema already guarantees a complete {why, for} whenever it
// does — so both props are always real, non-empty strings, never undefined.
//
// AuthorNote answers "who is accountable for this work?" (universal,
// identical on every entry). This answers "why does this particular work
// exist, and who did I write it for?" (piece-specific, present only where
// it was authored). Do not merge them.
interface Props {
	why: string;
	for: string;
}

const { why, for: forWhom } = Astro.props;
---

<aside class="from-the-author" aria-labelledby="from-the-author-label">
	<p id="from-the-author-label" class="meta from-the-author-label">From the Author</p>
	<p class="from-the-author-why">{why}</p>
	<p class="from-the-author-for">
		<span class="meta from-the-author-for-label">For</span>{' '}
		{forWhom}
	</p>
</aside>

<style>
	/* Sprint 12.1.1 — journal marginalia, not a card, and not framed either.
	   No border-top/border-bottom (the title <hr> and, on mobile, the TOC's
	   own rules already provide enough seam density without this adding a
	   third), no fill, no shadow, no radius, no accent stripe, no icon, no
	   avatar. The component is distinguished by label, type hierarchy, and
	   secondary ink alone — deliberately not a research primitive's boxed
	   --bg-subtle treatment, which signals argument topology (a claim,
	   evidence, a counterpoint), a different semantic role than orientation. */
	.from-the-author {
		margin: 0 0 var(--space-6);
		padding: 0;
		border: 0;
	}
	.from-the-author p {
		margin: 0;
	}
	.from-the-author-label {
		text-transform: uppercase;
		margin-bottom: var(--space-3);
	}
	/* --text-base (16px), not --text-sm (14px): the article body itself
	   reads at ~20px, so --text-base already creates a clear secondary
	   hierarchy on its own — --text-sm would push real orientation prose
	   into fine-print/metadata territory, which is wrong for a paragraph
	   meant to be read, not skimmed. */
	.from-the-author-why {
		color: var(--text-secondary);
		font-size: var(--text-base);
		line-height: 1.6;
		margin-bottom: var(--space-3);
	}
	.from-the-author-for-label {
		margin-right: var(--space-2);
	}
	.from-the-author-for {
		color: var(--text-secondary);
		font-size: var(--text-base);
	}
</style>
