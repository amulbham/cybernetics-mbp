---
import { Image } from 'astro:assets';
import logoDark from '../assets/logo-header-dark.png';
import logoLight from '../assets/logo-header-light.png';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';

// Search is a utility control (icon button next to the theme toggle), not a
// text nav link, so it doesn't go through HeaderLink.astro's active-check —
// which strips import.meta.env.BASE_URL from the pathname and only works
// because it separately reconstructs a leading slash afterward. With no
// `base` configured on this site, BASE_URL is '/', and naively replacing
// that would strip the pathname's own leading slash too ('/search' ->
// 'search') — a real gotcha hit building this, not copied on purpose.
// Astro.url.pathname is already the plain absolute path here; no stripping needed.
const isSearchActive = Astro.url.pathname === '/search' || Astro.url.pathname === '/search/';
---

<a class="skip-link" href="#main-content">Skip to main content</a>
<header data-pagefind-ignore>
	<nav>
		<h2>
			<a class="brand" href="/" aria-label={SITE_TITLE}>
				<Image class="logo-light" src={logoLight} alt="" height={26} />
				<Image class="logo-dark" src={logoDark} alt="" height={26} />
				<span class="brand-text">{SITE_TITLE}</span>
			</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/" class="home-link">Home</HeaderLink>
			<HeaderLink href="/research">Research</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="right-controls">
			<a
				class="search-control"
				href="/search"
				aria-label="Search"
				aria-current={isSearchActive ? 'page' : undefined}
			>
				<svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
					<circle cx="10.5" cy="10.5" r="6.25" stroke="currentColor" stroke-width="1.75"></circle>
					<path d="M15.2 15.2 L20 20" stroke="currentColor" stroke-width="1.75" stroke-linecap="square"
					></path>
				</svg>
			</a>
			<ThemeToggle />
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--bg);
		border-bottom: 1px solid var(--border);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
	}
	.brand img {
		display: block;
		width: auto;
	}
	/* Two logo assets, toggled by theme rather than one raster swapped by JS —
	   mirrors the color-token dark-mode pattern in global.css (explicit choice
	   via [data-theme], OS default via the media query when no explicit
	   choice has been made). */
	.brand .logo-dark {
		display: none;
	}
	:root[data-theme='dark'] .brand .logo-light {
		display: none;
	}
	:root[data-theme='dark'] .brand .logo-dark {
		display: block;
	}
	@media (prefers-color-scheme: dark) {
		:root:not([data-theme='light']) .brand .logo-light {
			display: none;
		}
		:root:not([data-theme='light']) .brand .logo-dark {
			display: block;
		}
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--text-primary);
		border-bottom: 2px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		flex-wrap: nowrap;
	}
	.right-controls {
		display: flex;
		align-items: center;
		gap: 0.75em;
	}
	/* Matches .theme-toggle's box exactly (same 2.25rem circle, same border/
	   hover treatment) so the two read as one utility pair, not two different
	   button styles next to each other. */
	.search-control {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0;
		border: 1px solid var(--border);
		border-radius: var(--radius-full);
		background: transparent;
		color: var(--text-primary);
	}
	.search-control:hover {
		background: var(--bg-subtle);
	}
	/* A circular control can't take a text link's border-bottom underline cue
	   without looking like a broken shape — a full border ring is the same
	   signal (border color = current location), adapted to the shape. */
	.search-control[aria-current='page'] {
		border-color: var(--accent);
	}

	@media (max-width: 767px) {
		nav a {
			padding: 0.75em 0.4em;
		}
		.home-link {
			display: none;
		}
		.brand-text {
			display: none;
		}
	}
</style>
