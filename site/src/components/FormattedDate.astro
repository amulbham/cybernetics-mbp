---
interface Props {
	date: Date;
	/** Format the calendar day in UTC. Forward scholarly pages set this so the visible
	 * date always agrees with `datetime` (UTC) and the Highwire/JSON-LD dates, whatever
	 * timezone the build process runs in (T29.3a). Omitted, display is unchanged. */
	utc?: boolean;
}

const { date, utc } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString('en-us', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
			...(utc ? { timeZone: 'UTC' } : {}),
		})
	}
</time>
