---
// Sticky spatial-orientation aid for long-form papers. A scroll-spy
// (IntersectionObserver, see the script below) highlights the current
// section as the reader scrolls. Gating by heading count keeps short papers
// (4 ## headings each, measured) from getting a token TOC that adds nothing.
// The financial-aid paper has 15.
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
	variant?: 'rail' | 'mobile' | 'both';
}

const MIN_SECTIONS = 6;

const { headings, variant = 'both' } = Astro.props;
const sections = headings.filter((heading) => heading.depth === 2);
const showToc = sections.length >= MIN_SECTIONS;
---

{
	showToc && (variant === 'mobile' || variant === 'both') && (
		<details class="toc-mobile" data-toc-mobile>
			<summary>
				<span>Table of Contents</span>
				<span class="toc-count">({sections.length} sections)</span>
			</summary>
			<ul>
				{sections.map((heading) => (
					<li>
						<a href={`#${heading.slug}`} data-toc-mobile-link={heading.slug}>
							{heading.text}
						</a>
					</li>
				))}
			</ul>
		</details>
	)
}

{
	showToc && (variant === 'rail' || variant === 'both') && (
		<nav class="toc-rail" aria-label="Table of contents" data-toc-rail>
			<p class="toc-label meta">Contents</p>
			<ul>
				{sections.map((heading) => (
					<li>
						<a href={`#${heading.slug}`} data-toc-link={heading.slug}>
							{heading.text}
						</a>
					</li>
				))}
			</ul>
		</nav>
	)
}

<style>
	.toc-rail {
		display: none;
	}
	@media (min-width: 1100px) {
		.toc-rail {
			display: block;
			width: 220px;
			flex-shrink: 0;
			position: sticky;
			top: var(--space-8);
			align-self: flex-start;
			max-height: calc(100vh - var(--space-8) * 2);
			overflow-y: auto;
		}
	}
	.toc-label {
		margin: 0 0 0.75em;
		text-transform: uppercase;
	}
	.toc-rail ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6em;
	}
	.toc-rail a {
		color: var(--text-secondary);
		text-decoration: none;
		font-size: 0.9em;
		line-height: 1.4;
	}
	.toc-rail a:hover,
	.toc-rail a:focus-visible {
		color: var(--accent);
	}
	.toc-rail a.active {
		color: var(--accent);
		font-weight: 700;
	}
</style>

<script is:inline>
	// astro:page-load (not DOMContentLoaded) so this also re-initializes when a
	// View Transitions client-side navigation lands on a paper page — the TOC
	// rail and article body are both swapped, so any previous observer and its
	// element references are stale.
	(function () {
		var observer;
		function initToc() {
			// 1. Mobile TOC: automatically collapse <details> when a section link is tapped
			var mobileDetails = document.querySelector('[data-toc-mobile]');
			var mobileLinks = document.querySelectorAll('[data-toc-mobile-link]');
			if (mobileDetails && mobileLinks.length > 0) {
				mobileLinks.forEach(function (link) {
					link.addEventListener('click', function () {
						mobileDetails.removeAttribute('open');
					});
				});
			}

			// 2. Desktop TOC rail scroll-spy
			if (observer) observer.disconnect();
			var links = document.querySelectorAll('[data-toc-link]');
			if (links.length === 0) return;
			var headings = [];
			links.forEach(function (link) {
				var slug = link.getAttribute('data-toc-link');
				var heading = slug && document.getElementById(slug);
				if (heading) headings.push({ heading: heading, link: link });
			});
			if (headings.length === 0) return;

			function setActive(activeLink) {
				links.forEach(function (l) {
					l.classList.toggle('active', l === activeLink);
				});
			}

			observer = new IntersectionObserver(
				function (entries) {
					var visible = entries.filter(function (e) {
						return e.isIntersecting;
					});
					if (visible.length === 0) return;
					var topmost = visible.reduce(function (a, b) {
						return a.boundingClientRect.top < b.boundingClientRect.top ? a : b;
					});
					var match = headings.find(function (h) {
						return h.heading === topmost.target;
					});
					if (match) setActive(match.link);
				},
				{ rootMargin: '0px 0px -70% 0px', threshold: 0 }
			);
			headings.forEach(function (h) {
				observer.observe(h.heading);
			});
		}
		document.addEventListener('astro:page-load', initToc);
	})();
</script>
