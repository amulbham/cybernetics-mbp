---
// Sticky spatial-orientation aid for long-form papers. A scroll-spy
// (IntersectionObserver) highlights the current section as the reader
// scrolls — the init script lives in ArticleShell.astro, not here, since
// PaperLayout renders this component twice (variant="mobile" + "rail") and
// a script in a twice-rendered component runs twice; ArticleShell renders
// exactly once per page. Gating by heading count keeps short papers (4 ##
// headings each, measured) from getting a token TOC that adds nothing. The
// financial-aid paper has 15.
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
	variant?: 'rail' | 'mobile' | 'both';
}

const MIN_SECTIONS = 6;

const { headings, variant = 'both' } = Astro.props;
const sections = headings.filter((heading) => heading.depth === 2);
const showToc = sections.length >= MIN_SECTIONS;
---

{
	showToc && (variant === 'mobile' || variant === 'both') && (
		<details class="toc-mobile" data-toc-mobile>
			<summary>
				<span>Table of Contents</span>
				<span class="toc-count">({sections.length} sections)</span>
			</summary>
			<ul>
				{sections.map((heading) => (
					<li>
						<a href={`#${heading.slug}`} data-toc-mobile-link={heading.slug}>
							{heading.text}
						</a>
					</li>
				))}
			</ul>
		</details>
	)
}

{
	showToc && (variant === 'rail' || variant === 'both') && (
		<nav class="toc-rail" aria-label="Table of contents" data-toc-rail>
			<p class="toc-label meta">Contents</p>
			<ul>
				{sections.map((heading) => (
					<li>
						<a href={`#${heading.slug}`} data-toc-link={heading.slug}>
							{heading.text}
						</a>
					</li>
				))}
			</ul>
		</nav>
	)
}

<style>
	.toc-rail {
		display: none;
	}
	@media (min-width: 1100px) {
		.toc-rail {
			display: block;
			width: 220px;
			flex-shrink: 0;
			position: sticky;
			top: var(--space-8);
			align-self: flex-start;
			max-height: calc(100vh - var(--space-8) * 2);
			overflow-y: auto;
		}
	}
	.toc-label {
		margin: 0 0 0.75em;
		text-transform: uppercase;
	}
	.toc-rail ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6em;
	}
	.toc-rail a {
		color: var(--text-secondary);
		text-decoration: none;
		font-size: 0.9em;
		line-height: 1.4;
	}
	.toc-rail a:hover,
	.toc-rail a:focus-visible {
		color: var(--accent);
	}
	.toc-rail a.active {
		color: var(--accent);
		font-weight: 700;
	}
</style>
