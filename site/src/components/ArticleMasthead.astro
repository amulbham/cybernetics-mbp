---
// Byline/correspondence block for research entries — a real component
// instead of hand-typed Markdown in each article's body, specifically
// because that data (name, affiliation, correspondence) is identical on
// every entry. Hand-typing it per piece is exactly how two early pieces
// drifted into different formats from each other. See AGENTS.md.
import type { CollectionEntry } from 'astro:content';
import { AUTHOR, LICENSE, SOCIAL_LINKS } from '../consts';
import { formatLabel } from '../lib/research-routing';

interface Props {
	format: CollectionEntry<'research'>['data']['format'];
	doi?: string;
}

const { format, doi } = Astro.props;

// Same derivation AuthorNote.astro uses: the visible ORCID text must never
// be a second, hand-typed copy of SOCIAL_LINKS.orcid (the href).
const orcidLabel = SOCIAL_LINKS.orcid.replace(/^https?:\/\//, '');
---

<div class="masthead meta">
	<p class="name">{AUTHOR.name}</p>
	<p>{AUTHOR.affiliation}, {AUTHOR.location}</p>
	<p>
		<a href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a>
		{' · '}
		<a href={SOCIAL_LINKS.linkedin}>linkedin.com/in/amul-bham</a>
		{' · '}
		<a class="orcid" href={SOCIAL_LINKS.orcid}>{orcidLabel}</a>
		{
			doi && (
				<>
					{' · '}
					<a href={doi}>{doi.replace(/^https?:\/\//, '')}</a>
				</>
			)
		}
	</p>
	<p>{formatLabel(format)} · Licensed <a href={LICENSE.url}>{LICENSE.label}</a></p>
</div>

<style>
	.masthead {
		text-align: center;
		margin: 0 0 1.5em;
	}
	.masthead p {
		margin: 0 0 0.3em;
	}
	.masthead p:last-child {
		margin-bottom: 0;
	}
	.name {
		font-family: var(--font-atkinson);
		font-weight: 700;
		font-size: 1.05em;
		color: var(--text-primary);
	}
</style>
