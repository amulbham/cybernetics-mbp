---
// Byline/correspondence block for research entries — a real component
// instead of hand-typed Markdown in each article's body, specifically
// because that data (name, role, correspondence) is identical on
// every entry. Hand-typing it per piece is exactly how two early pieces
// drifted into different formats from each other. See AGENTS.md.
import type { CollectionEntry } from 'astro:content';
import { AUTHOR, SOCIAL_LINKS } from '../consts';
import type { WorkLicense } from '../lib/license';
import { formatLabel } from '../lib/research-routing';

interface Props {
	format: CollectionEntry<'research'>['data']['format'];
	doi?: string;
	scholarly?: boolean;
	candidate?: boolean;
	/** The work's effective license (resolved once by ResearchLayout). Never a sitewide constant. */
	license: WorkLicense;
}

const { format, doi, scholarly, candidate, license } = Astro.props;

// Same derivation AuthorNote.astro uses: the visible ORCID text must never
// be a second, hand-typed copy of SOCIAL_LINKS.orcid (the href).
const orcidLabel = SOCIAL_LINKS.orcid.replace(/^https?:\/\//, '');

// A DOI is one long unbroken token, so on a narrow column the global
// overflow-wrap fallback split it mid-token and could strand a few digits
// ("…zenodo.24120" / "332"). The visible text must stay exactly as is (the
// publishing-facts validator reads it from the built HTML), so the link is
// instead scaled to fit its column; see `.doi` below. This is its length in
// characters, for that calculation.
const doiChars = doi ? (scholarly ? doi : doi.replace(/^https?:\/\//, '')).length : 0;
---

{scholarly ? (
	<div class="masthead meta">
		<p class="name">{AUTHOR.name}</p>
		<p>{AUTHOR.role}</p>
		<p><a class="orcid" href={SOCIAL_LINKS.orcid}>{orcidLabel}</a></p>
		{candidate && <p class="candidate-status">Candidate specimen — not published</p>}
		{doi && <p>{candidate ? 'Intended concept DOI (public verification pending):' : 'DOI:'} <a class="doi" style={`--doi-chars:${doiChars}`} href={doi}>{doi}</a></p>}
		<p>{formatLabel(format)} · Licensed <a href={license.url}>{license.label}</a></p>
	</div>
) : (
<div class="masthead meta">
	<p class="name">{AUTHOR.name}</p>
	<p>{AUTHOR.role}, {AUTHOR.location}</p>
	<p>
		<a href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a>
		{' · '}
		<a href={SOCIAL_LINKS.linkedin}>linkedin.com/in/amul-bham</a>
		{' · '}
		<a class="orcid" href={SOCIAL_LINKS.orcid}>{orcidLabel}</a>
		{
			doi && (
				<>
					{' · '}
					<a class="doi" style={`--doi-chars:${doiChars}`} href={doi}>{doi.replace(/^https?:\/\//, '')}</a>
				</>
			)
		}
	</p>
	<p>{formatLabel(format)} · Licensed <a href={license.url}>{license.label}</a></p>
</div>
)}

<style>
	.masthead {
		text-align: center;
		margin: 0 0 1.5em;
	}
	.masthead p {
		margin: 0 0 0.3em;
	}
	.masthead p:last-child {
		margin-bottom: 0;
	}
	/* The DOI is one unbreakable token; scale it so the whole token fits the column
	   instead of the global overflow-wrap fallback splitting it mid-token and
	   stranding a few digits. A character is 0.62em wide here (monospace 0.6em plus
	   the .meta letter-spacing of 0.02em); 0.63em adds slack. Never larger than the
	   normal .meta size (so wide columns are unchanged), never smaller than 0.59rem
	   (about 9.4px, which is what a 320px screen needs); below that it falls back to the
	   old mid-token wrap rather than becoming unreadable. */
	.masthead {
		container-type: inline-size;
	}
	/* Screen only (T31.2): unscoped, this size outranked the print masthead's
	   10pt and shrank the PDF DOI to 8.25pt; in print the link inherits 10pt. */
	@media screen {
		.doi {
			font-size: clamp(0.59rem, calc(100cqi / (var(--doi-chars) * 0.63)), var(--text-xs));
		}
	}
	.name {
		font-family: var(--font-atkinson);
		font-weight: 700;
		font-size: 1.05em;
		color: var(--text-primary);
	}
</style>
