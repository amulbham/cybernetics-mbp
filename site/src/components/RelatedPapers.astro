---
// Surfaces up to 3 other papers sharing the current paper's pillar and/or
// tags. Scored, not just filtered, so a same-pillar paper with no tag
// overlap still outranks an off-pillar paper with one shared tag.
import { getCollection } from 'astro:content';
import Badge from './Badge.astro';
import Card from './Card.astro';
import { formatPillarLabel } from '../lib/pillars';

interface Props {
	currentId: string;
	pillar: string;
	tags: string[];
}

const { currentId, pillar, tags } = Astro.props;

const allPapers = await getCollection('papers');
const related = allPapers
	.filter((paper) => paper.id !== currentId)
	.map((paper) => {
		const pillarScore = paper.data.pillar === pillar ? 2 : 0;
		const tagScore = paper.data.tags.filter((tag) => tags.includes(tag)).length;
		return { paper, score: pillarScore + tagScore };
	})
	.filter((entry) => entry.score > 0)
	.sort((a, b) => b.score - a.score || b.paper.data.pubDate.valueOf() - a.paper.data.pubDate.valueOf())
	.slice(0, 3)
	.map((entry) => entry.paper);
---

{
	related.length > 0 && (
		<section class="related-papers">
			<h2>Related Research</h2>
			<ul>
				{related.map((paper) => (
					<Card href={`/research-hub/${paper.data.pillar}/${paper.id}/`}>
						<Badge variant="pillar" pillar={paper.data.pillar}>
							{formatPillarLabel(paper.data.pillar)}
						</Badge>
						<h3>{paper.data.title}</h3>
						<p>{paper.data.excerpt}</p>
					</Card>
				))}
			</ul>
		</section>
	)
}

<style>
	.related-papers {
		margin-top: 3em;
		padding-top: 2em;
		border-top: 1px solid var(--border);
	}
	.related-papers ul {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 1.25em;
		list-style: none;
		margin: 1em 0 0;
		padding: 0;
	}
	.related-papers h3 {
		margin: 0.6em 0 0.4em;
		font-size: 1.05em;
		color: var(--card-hover-color, var(--text-primary));
		transition: color 0.15s ease;
	}
	.related-papers p {
		margin: 0;
		font-size: 0.9em;
		color: var(--text-primary);
	}
</style>
