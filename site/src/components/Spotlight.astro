---
import { getEntry } from 'astro:content';
import { HOMEPAGE_SPOTLIGHT } from '../consts';
import { categoryLabel } from '../lib/categories';
import { canonicalPath, formatLabel } from '../lib/research-routing';
import Card from './Card.astro';
import FormattedDate from './FormattedDate.astro';

// Fails the build, not a silent empty box — a wrong HOMEPAGE_SPOTLIGHT slug
// is a mistake that should be caught at build time, not shipped as a
// homepage with a missing section.
const spotlight = await getEntry('research', HOMEPAGE_SPOTLIGHT);
if (!spotlight) {
	throw new Error(`HOMEPAGE_SPOTLIGHT "${HOMEPAGE_SPOTLIGHT}" is not a research entry`);
}
---

<section class="spotlight">
	<p class="meta spotlight-label">Spotlight</p>
	<ul class="spotlight-feed">
		<Card href={canonicalPath(spotlight)}>
			<span class="meta spotlight-meta">
				<FormattedDate date={spotlight.data.pubDate} /> · {categoryLabel(spotlight.data.category)}
			</span>
			<h3>{spotlight.data.title}</h3>
			<p>{spotlight.data.excerpt}</p>
			{/* Visible affordance only: the Card is already one anchor, so this must not be a second link. */}
			<span class="spotlight-read">Read {formatLabel(spotlight.data.format).toLowerCase()} →</span>
		</Card>
	</ul>
</section>

<style>
	.spotlight {
		max-width: var(--content-width-wide);
		margin: 0 auto 3em;
	}
	.spotlight-label {
		margin: 0 0 1em;
	}
	.spotlight-feed {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.spotlight-meta {
		display: block;
	}
	.spotlight-feed h3 {
		margin: 0.7em 0 0.5em;
		font-size: 1.5em;
		color: var(--card-hover-color, var(--text-primary));
		transition: color 0.15s ease;
	}
	.spotlight-feed p {
		margin: 0 0 0.6em;
		max-width: var(--content-width-prose);
		font-size: 1.05em;
		color: var(--text-primary);
	}
	.spotlight-read {
		display: inline-block;
		margin-top: 0.4em;
		font-weight: 700;
		color: var(--accent);
	}
</style>
