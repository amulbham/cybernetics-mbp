---
// No icon library on this site (see AGENTS.md's "Design system" section) —
// social links render as mono-font text-abbreviation chips instead of SVG
// brand marks.
import { SOCIAL_LINKS } from '../consts';

const links = [
	{ label: 'Amul Bham on LinkedIn', href: SOCIAL_LINKS.linkedin, text: 'in' },
	{ label: 'Amul Bham on Substack', href: SOCIAL_LINKS.substack, text: 'S' },
	{ label: 'Amul Bham on GitHub', href: SOCIAL_LINKS.github, text: '</>' },
] as const;
---

<div class="social-links">
	{
		links.map(({ label, href, text }) => (
			<a href={href} target="_blank" rel="noopener noreferrer" aria-label={label}>
				{text}
			</a>
		))
	}
</div>

<style>
	.social-links {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}
	.social-links a {
		display: inline-flex;
		align-items: center;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 700;
		color: var(--text-secondary);
		padding: 4px 8px;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		background: var(--bg-subtle);
	}
	.social-links a:hover,
	.social-links a:focus-visible {
		color: var(--accent);
		border-color: var(--accent);
	}
	.social-links a:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
</style>
