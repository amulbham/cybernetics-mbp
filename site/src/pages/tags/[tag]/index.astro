---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Badge from '../../../components/Badge.astro';
import Card from '../../../components/Card.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { formatPillarLabel } from '../../../lib/pillars';
import { slugifyTag } from '../../../lib/tags.ts';

interface TagEntry {
	title: string;
	href: string;
	pubDate: Date;
	excerpt: string;
	pillar?: string;
}

export async function getStaticPaths() {
	const [papers, posts] = await Promise.all([getCollection('papers'), getCollection('blog')]);
	const bySlug = new Map<string, { label: string; entries: TagEntry[] }>();

	function addEntry(slug: string, label: string, entry: TagEntry) {
		if (!bySlug.has(slug)) bySlug.set(slug, { label, entries: [] });
		bySlug.get(slug)!.entries.push(entry);
	}

	for (const paper of papers) {
		for (const tag of paper.data.tags) {
			addEntry(slugifyTag(tag), tag, {
				title: paper.data.title,
				href: `/research-hub/${paper.data.pillar}/${paper.id}/`,
				pubDate: paper.data.pubDate,
				excerpt: paper.data.excerpt,
				pillar: paper.data.pillar,
			});
		}
	}
	for (const post of posts) {
		for (const tag of post.data.tags) {
			addEntry(slugifyTag(tag), tag, {
				title: post.data.title,
				href: `/blog/${post.id}/`,
				pubDate: post.data.pubDate,
				excerpt: post.data.excerpt,
			});
		}
	}

	return [...bySlug.entries()].map(([slug, { label, entries }]) => ({
		params: { tag: slug },
		props: { label, entries: entries.sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf()) },
	}));
}

interface Props {
	label: string;
	entries: TagEntry[];
}

const { label, entries } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Tag: ${label}`} description={`Research and writing tagged "${label}".`} />
		<style>
			.intro {
				margin-bottom: 2.5em;
				color: var(--text-secondary);
			}
			.entries {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1.5em;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.entries h3 {
				margin: 0.6em 0 0.4em;
				font-size: 1.2em;
				color: var(--card-hover-color, var(--text-primary));
				transition: color 0.15s ease;
			}
			.entries p {
				margin: 0;
				color: var(--text-primary);
				font-size: 0.95em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Tag: {label}</h1>
			<p class="intro">
				{entries.length} item{entries.length === 1 ? '' : 's'} tagged "{label}".
			</p>
			<ul class="entries">
				{
					entries.map((entry) => (
						<Card href={entry.href}>
							{entry.pillar ? (
								<Badge variant="pillar" pillar={entry.pillar}>
									{formatPillarLabel(entry.pillar)}
								</Badge>
							) : (
								<Badge variant="neutral">Blog</Badge>
							)}
							<span class="meta">
								<FormattedDate date={entry.pubDate} />
							</span>
							<h3>{entry.title}</h3>
							<p>{entry.excerpt}</p>
						</Card>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
