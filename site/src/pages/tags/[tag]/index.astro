---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Badge from '../../../components/Badge.astro';
import Card from '../../../components/Card.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { categoryLabel } from '../../../lib/categories';
import { canonicalPath } from '../../../lib/research-routing';
import { slugifyTag } from '../../../lib/tags.ts';

export async function getStaticPaths() {
	const entries = await getCollection('research');
	const bySlug = new Map<string, { label: string; entries: CollectionEntry<'research'>[] }>();

	for (const entry of entries) {
		for (const tag of entry.data.tags) {
			const slug = slugifyTag(tag);
			if (!bySlug.has(slug)) bySlug.set(slug, { label: tag, entries: [] });
			bySlug.get(slug)!.entries.push(entry);
		}
	}

	return [...bySlug.entries()].map(([slug, { label, entries }]) => ({
		params: { tag: slug },
		props: {
			label,
			entries: entries.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

interface Props {
	label: string;
	entries: CollectionEntry<'research'>[];
}

const { label, entries } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		{/* Launch policy (T22.0): tag pages stay navigable but out of search results and the sitemap. */}
		<BaseHead title={`Tag: ${label}`} description={`Research and writing tagged "${label}".`} noindex />
		<style>
			.intro {
				margin-bottom: 2.5em;
				color: var(--text-secondary);
			}
			.entries {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1.5em;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.entries h3 {
				margin: 0.6em 0 0.4em;
				font-size: 1.2em;
				color: var(--card-hover-color, var(--text-primary));
				transition: color 0.15s ease;
			}
			.entries p {
				margin: 0;
				color: var(--text-primary);
				font-size: 0.95em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<h1>Tag: {label}</h1>
			<p class="intro">
				{entries.length} item{entries.length === 1 ? '' : 's'} tagged "{label}".
			</p>
			<ul class="entries">
				{
					entries.map((entry) => (
						<Card href={canonicalPath(entry)}>
							<Badge variant="pillar" category={entry.data.category}>
								{categoryLabel(entry.data.category)}
							</Badge>
							<span class="meta">
								<FormattedDate date={entry.data.pubDate} />
							</span>
							<h3>{entry.data.title}</h3>
							<p>{entry.data.excerpt}</p>
						</Card>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
