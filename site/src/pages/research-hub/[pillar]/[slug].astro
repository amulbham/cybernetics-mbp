---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import PaperLayout from '../../../layouts/PaperLayout.astro';

export async function getStaticPaths() {
	const papers = await getCollection('papers');
	return papers.map((paper) => ({
		params: { pillar: paper.data.pillar, slug: paper.id },
		props: paper,
	}));
}
type Props = CollectionEntry<'papers'>;

const paper = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(paper);
---

<PaperLayout
	{...paper.data}
	id={paper.id}
	minutesRead={remarkPluginFrontmatter.minutesRead}
	wordCount={remarkPluginFrontmatter.wordCount}
	headings={headings}
>
	<Content />
</PaperLayout>
