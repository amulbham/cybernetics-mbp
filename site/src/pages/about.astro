---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';

const pageTitle = `About — ${SITE_TITLE}`;
const pageDescription =
	'Systems researcher working at the intersection of AI infrastructure, technical SEO architecture, and policy rules engines.';

const sameAsLinks = Object.values(SOCIAL_LINKS);
const canonicalURL = new URL('/about/', Astro.site).toString();

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	dateCreated: '2026-08-01T00:00:00Z',
	dateModified: new Date().toISOString(),
	mainEntity: {
		'@type': 'Person',
		name: 'Amul Bham',
		jobTitle: 'Systems & AI Researcher',
		url: canonicalURL,
		sameAs: sameAsLinks,
		knowsAbout: [
			'AI Systems & Infrastructure',
			'Information Architecture & Technical SEO',
			'Distributed Systems & Event-Driven Architecture',
			'Institutional Policy Rules Engines',
		],
	},
};

const jsonLdString = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<script type="application/ld+json" set:html={jsonLdString} />
		<style>
			main {
				width: var(--content-width-prose);
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			.about-header {
				margin-bottom: 2.5em;
				text-align: left;
			}
			.eyebrow {
				font-family: var(--font-mono);
				font-size: var(--text-xs);
				letter-spacing: 0.15em;
				text-transform: uppercase;
				color: var(--accent);
				margin-bottom: 0.75em;
			}
			.about-header h1 {
				margin-bottom: 0.5em;
			}
			.lead {
				font-size: 1.15em;
				line-height: 1.6;
				color: var(--text-primary);
			}
			.pillar-grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: 1.5em;
				margin: 2em 0;
			}
			.pillar-card {
				padding: 1.25em 1.5em;
				border: 1px solid var(--border);
				border-radius: var(--radius-md);
				background-color: var(--bg-subtle);
			}
			.pillar-card h3 {
				font-size: 1.1em;
				margin: 0 0 0.5em 0;
			}
			.pillar-card p {
				margin: 0;
				font-size: 0.95em;
				color: var(--text-secondary);
				line-height: 1.5;
			}
			.credentials-list {
				list-style: none;
				padding: 0;
				margin: 1.5em 0;
				display: flex;
				flex-direction: column;
				gap: 0.75em;
			}
			.credentials-list li {
				font-size: 0.95em;
				display: flex;
				align-items: baseline;
				gap: 0.5em;
			}
			.credentials-list strong {
				font-family: var(--font-mono);
				font-size: var(--text-xs);
				text-transform: uppercase;
				color: var(--text-secondary);
				min-width: 110px;
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<div class="about-header">
				<p class="eyebrow">Researcher Profile</p>
				<h1>Amul Bham</h1>
				<p class="lead">
					Independent systems researcher and engineer investigating how AI infrastructure,
					information retrieval, and deterministic policy systems converge in production.
				</p>
			</div>

			<section class="prose">
				<h2>Research Focus</h2>
				<p>
					My work explores systems where published rules, economic incentives, and computational
					models meet. Rather than treating software engineering, search mechanics, and policy as
					siloed domains, I analyze them as structural architectures:
				</p>

				<div class="pillar-grid">
					<div class="pillar-card">
						<h3>AI Systems</h3>
						<p>
							Agentic retrieval architectures, deterministic pipelines, and the operational
							tradeoffs of running language models at production scale.
						</p>
					</div>
					<div class="pillar-card">
						<h3>SEO Architecture</h3>
						<p>
							Information architecture, crawl graph topology, and structured data deployed as
							foundational software infrastructure.
						</p>
					</div>
					<div class="pillar-card">
						<h3>Systems Architecture</h3>
						<p>
							Distributed systems mechanics, idempotency protocols, and fault-tolerant event-driven
							pipelines.
						</p>
					</div>
					<div class="pillar-card">
						<h3>Policy Systems</h3>
						<p>
							Institutional and financial policies modeled as deterministic compilers and rules
							engines, examining rational-actor adaptations.
						</p>
					</div>
				</div>

				<h2>Methodology</h2>
				<p>
					All research papers published here prioritize reproducible systems models, empirical
					data, and explicit formal protocols over speculative commentary.
				</p>

				<h2>Verified Credentials & Channels</h2>
				<ul class="credentials-list">
					<li>
						<strong>ORCID</strong>
						<a href={SOCIAL_LINKS.orcid} target="_blank" rel="noopener noreferrer">
							0009-0009-7660-4031
						</a>
					</li>
					<li>
						<strong>LinkedIn</strong>
						<a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer">
							linkedin.com/in/amul-bham
						</a>
					</li>
					<li>
						<strong>Substack</strong>
						<a href={SOCIAL_LINKS.substack} target="_blank" rel="noopener noreferrer">
							amulbham.substack.com
						</a>
					</li>
					<li>
						<strong>GitHub</strong>
						<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer">
							github.com/amulbham
						</a>
					</li>
					<li>
						<strong>Correspondence</strong>
						<a href="mailto:amul.bham@gmail.com">amul.bham@gmail.com</a>
					</li>
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
