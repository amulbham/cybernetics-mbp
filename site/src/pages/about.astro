---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
import { CATEGORIES } from '../lib/categories';
import { personIdentity } from '../lib/structured-data';

const pageTitle = `About — ${SITE_TITLE}`;
const pageDescription =
	'From LLM memory failures to cognitive architecture and an unexpected convergence with cybernetics—explore the research journey of Amul Bham.';

// Sprint 11.1 — mainEntity is the canonical Person core (src/lib/structured-data.ts)
// plus this page's own contextual enrichment (jobTitle/knowsAbout), which
// stays here deliberately: About remains the richest structured description
// of the one canonical Person, and richer-here-than-elsewhere is legitimate
// per-context detail, not identity drift (see CHANGELOG.md's Sprint 11.1 entry).
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	dateCreated: '2026-08-01T00:00:00Z',
	dateModified: new Date().toISOString(),
	mainEntity: {
		...personIdentity(Astro.site),
		jobTitle: 'Systems & AI Researcher',
		knowsAbout: [
			'AI Systems & Infrastructure',
			'Information Architecture & Technical SEO',
			'Distributed Systems & Event-Driven Architecture',
			'Institutional Policy Rules Engines',
		],
	},
};

const jsonLdString = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<script type="application/ld+json" set:html={jsonLdString} />
		<style>
			main {
				width: var(--content-width-prose);
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			.about-header {
				margin-bottom: 1.5em;
				text-align: left;
			}
			.eyebrow {
				font-family: var(--font-mono);
				font-size: var(--text-xs);
				letter-spacing: 0.15em;
				text-transform: uppercase;
				color: var(--accent);
				margin-bottom: 0.75em;
			}
			.about-header h1 {
				margin-bottom: 0.5em;
			}
			.lead {
				font-size: 1.15em;
				line-height: 1.6;
				color: var(--text-primary);
			}
			.pillar-grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: 1.5em;
				margin: 2em 0;
			}
			.pillar-card {
				padding: 1.25em 1.5em;
				border: 1px solid var(--border);
				border-radius: var(--radius-md);
				background-color: var(--bg-subtle);
			}
			.pillar-card h3 {
				font-size: 1.1em;
				margin: 0 0 0.5em 0;
			}
			.pillar-card p {
				margin: 0;
				font-size: 0.95em;
				color: var(--text-secondary);
				line-height: 1.5;
			}
			.prose > h2:first-child {
				margin-top: 0;
			}
			.profile-links {
				list-style: none;
				padding: 0;
				margin: 0.75em 0 1.65em;
				display: flex;
				flex-wrap: wrap;
				gap: 0.6em;
			}
			.profile-links a {
				display: inline-flex;
				flex-wrap: wrap;
				align-items: baseline;
				column-gap: 0.6em;
				min-height: 44px;
				box-sizing: border-box;
				padding: 0.55em 0.9em;
				border: 1px solid var(--border);
				border-radius: var(--radius-md);
				background-color: var(--bg-subtle);
				text-decoration: none;
				font-size: 0.95em;
			}
			.profile-links a:hover {
				border-color: var(--accent);
			}
			.profile-links a:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 2px;
			}
			.profile-links .link-name {
				font-family: var(--font-mono);
				font-size: var(--text-xs);
				text-transform: uppercase;
				color: var(--text-secondary);
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<div class="about-header">
				<p class="eyebrow">Researcher Profile</p>
				<h1>Amul Bham</h1>
				<p class="lead">
					The question started simply: why does an LLM lose the thread? Not randomly — structurally.
					The failures clustered in consistent ways, and consistent failures have consistent causes.
				</p>
			</div>

			<section class="prose">
				<h2>Profiles & Contact</h2>
				<ul class="profile-links">
					<li>
						<a href={SOCIAL_LINKS.orcid} target="_blank" rel="noopener noreferrer">
							<span class="link-name">ORCID</span> <span>0009-0009-7660-4031</span>
						</a>
					</li>
					<li>
						<a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer">
							<span class="link-name">LinkedIn</span> <span>linkedin.com/in/amul-bham</span>
						</a>
					</li>
					<li>
						<a href={SOCIAL_LINKS.substack} target="_blank" rel="noopener noreferrer">
							<span class="link-name">Substack</span> <span>amulbham.substack.com</span>
						</a>
					</li>
					<li>
						<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer">
							<span class="link-name">GitHub</span> <span>github.com/amulbham</span>
						</a>
					</li>
					<li>
						<a href="mailto:amul.bham@gmail.com">
							<span class="link-name">Email</span> <span>amul.bham@gmail.com</span>
						</a>
					</li>
				</ul>

				<h2>Background</h2>
				<p>
					I spent a decade in enterprise SEO, most recently as Principal SEO Manager at Skechers,
					building and integrating AI systems into business processes at scale. I knew what it looked
					like when a tool failed for surface reasons and when it failed for structural ones.
				</p>
				<p>
					What I found underneath the memory problem wasn't a missing feature. It was a missing
					architecture. Building it — what became the Mission Brief Protocol and the Cognitive Physics
					Series — led somewhere I didn't plan: a set of invariant conditions that converge with work
					in cybernetics dating to the 1950s. I didn't build on that literature. I found the same
					structure from a different angle. That form of convergence is part of the evidence. I left
					corporate work in early 2026 to research full time.
				</p>

				<h2>Research Focus</h2>
				<p>
					My work explores systems where published rules, economic incentives, and computational
					models meet. Rather than treating software engineering, search mechanics, and policy as
					siloed domains, I analyze them as structural architectures:
				</p>

				<div class="pillar-grid">
					{
						CATEGORIES.map((category) => (
							<div class="pillar-card">
								<h3>{category.label}</h3>
								<p>{category.description}</p>
							</div>
						))
					}
				</div>

				<h2>Methodology</h2>
				<p>
					My research doesn't begin with a topic. It begins with something noticed: a gap between what
					a system says it does and what it actually does, a constraint appearing twice under
					different names, or a mechanism that seems obvious once you see it and invisible before. The
					question forms around the observation, not the other way around.
				</p>
				<p>
					From there, I work from first principles. Rather than starting with an inherited framework,
					I derive the underlying structure independently, then compare it with established work. When
					that process converges with ideas developed across seven decades of cybernetics research,
					the convergence becomes evidence worth examining. It doesn't replace the argument. It gives
					us another reason to investigate the structure.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
