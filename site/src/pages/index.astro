---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import RecentResearch from '../components/RecentResearch.astro';
import Spotlight from '../components/Spotlight.astro';
import { HOMEPAGE_SPOTLIGHT, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { personIdentity } from '../lib/structured-data';

// T21.0 homepage: a short hero, one pinned spotlight (HOMEPAGE_SPOTLIGHT, consts.ts), a
// chronological feed of the next entries, and an exit to the archive. No category blocks —
// category navigation lives in the header/footer and on the research index.
const archiveCount = (await getCollection('research')).length;

// Homepage entity graph: establishes Amul Bham as a disambiguated Person
// entity and the site itself as a WebSite entity, for crawler/LLM entity
// association. Sprint 11.1 — both Person representations below are the one
// canonical core (src/lib/structured-data.ts), not hand-typed here; this
// file used to declare its own independent Person shape, and WebSite.author
// used to be a third, even thinner one with no url/sameAs at all — see
// CHANGELOG.md's Sprint 11.0/11.1 entries for why that was a real problem.
const personJsonLd = {
	'@context': 'https://schema.org',
	...personIdentity(Astro.site),
};

const websiteJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	url: Astro.site?.toString(),
	author: personIdentity(Astro.site),
};

// Escape `<` so JSON-LD can't break out of the script tag — same guard as ResearchLayout.astro.
const personJsonLdString = JSON.stringify(personJsonLd).replace(/</g, '\\u003c');
const websiteJsonLdString = JSON.stringify(websiteJsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={personJsonLdString} />
		<script type="application/ld+json" set:html={websiteJsonLdString} />
		<style>
			.hero {
				margin: 0 0 var(--space-7);
			}
			.hero h1 {
				margin-bottom: 0.6em;
			}
			.hero .positioning {
				font-size: 1.1em;
				color: var(--text-secondary);
			}
			.hero .about-link {
				margin: 1.25em 0 0;
				font-weight: 700;
			}
			.archive-link {
				margin: 0;
				font-weight: 700;
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<section class="hero">
				<h1>Research on knowledge, cognition, and complex systems.</h1>
				<p class="positioning">{SITE_DESCRIPTION}</p>
				<p class="about-link"><a href="/about">About the researcher →</a></p>
			</section>

			<Spotlight />

			<RecentResearch variant="feed" excludeId={HOMEPAGE_SPOTLIGHT} limit={5} />

			<p class="archive-link"><a href="/research/">View the full archive ({archiveCount} entries) →</a></p>
		</main>
		<Footer />
	</body>
</html>
