---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { formatPillarLabel } from '../lib/pillars';

const recentPapers = (await getCollection('papers'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				max-width: 720px;
				margin: 0 auto 3.5em;
				text-align: center;
			}
			.hero .eyebrow {
				margin: 0 0 1em;
				font-size: 0.85em;
				letter-spacing: 0.15em;
				text-transform: uppercase;
				color: rgb(var(--accent));
			}
			.hero h1 {
				margin-bottom: 0.6em;
			}
			.hero .positioning {
				font-size: 1.1em;
				color: rgb(var(--gray-dark));
			}
			.cta-links {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.75em;
				margin-top: 1.75em;
			}
			.cta {
				display: inline-flex;
				align-items: center;
				height: 2.5em;
				padding: 0 1.25em;
				border-radius: 0.6em;
				text-decoration: none;
				font-weight: 500;
			}
			.cta.primary {
				background: var(--accent);
				color: white;
			}
			.cta.secondary {
				border: 1px solid rgb(var(--gray-light));
				color: rgb(var(--black));
			}
			.recent-research {
				max-width: 960px;
				margin: 0 auto;
			}
			.section-heading {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1em;
				margin-bottom: 1em;
			}
			.section-heading h2 {
				margin: 0;
			}
			.section-heading a {
				font-size: 0.9em;
				white-space: nowrap;
			}
			.research-feed {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1.5em;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.research-feed li {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				padding: 1.25em;
			}
			.research-feed a {
				text-decoration: none;
				color: inherit;
			}
			.pillar-badge {
				display: inline-block;
				margin-bottom: 0.6em;
				padding: 0.2em 0.7em;
				border-radius: 999px;
				background-color: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				font-size: 0.75em;
			}
			.research-feed h3 {
				margin: 0 0 0.4em;
				font-size: 1.15em;
				color: rgb(var(--black));
			}
			.research-feed a:hover h3 {
				color: rgb(var(--accent));
			}
			.research-feed p {
				margin: 0 0 0.6em;
				font-size: 0.95em;
				color: rgb(var(--gray-dark));
			}
			.research-feed .date {
				color: rgb(var(--gray));
				font-size: 0.85em;
			}
			.empty {
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">Amul Bham</p>
				<h1>Applied research on AI systems, SEO architecture, and systems design.</h1>
				<p class="positioning">
					I design and build systems at the intersection of AI infrastructure, information
					architecture, and technical SEO — and publish research on how those disciplines converge
					in production.
				</p>
				<nav class="cta-links" aria-label="Primary">
					<a class="cta primary" href="/research-hub">Browse Research Hub</a>
					<a class="cta secondary" href="/about">About Amul</a>
				</nav>
			</section>

			<section class="recent-research">
				<div class="section-heading">
					<h2>Recent Research</h2>
					<a href="/research-hub">View all research →</a>
				</div>
				{
					recentPapers.length > 0 ? (
						<ul class="research-feed">
							{recentPapers.map((paper) => (
								<li>
									<a href={`/research-hub/${paper.data.pillar}/${paper.id}/`}>
										<span class="pillar-badge">{formatPillarLabel(paper.data.pillar)}</span>
										<h3>{paper.data.title}</h3>
										<p>{paper.data.description}</p>
										<span class="date">
											<FormattedDate date={paper.data.pubDate} />
										</span>
									</a>
								</li>
							))}
						</ul>
					) : (
						<p class="empty">No research published yet — check back soon.</p>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
