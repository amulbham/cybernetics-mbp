---
import BaseHead from '../components/BaseHead.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import RecentResearch from '../components/RecentResearch.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: var(--content-width-wide);
				max-width: calc(100% - 2em);
			}
			.hero {
				max-width: var(--content-width-prose);
				margin: 0 auto 3.5em;
				text-align: center;
			}
			.hero .eyebrow {
				margin: 0 0 1em;
				font-size: 0.85em;
				letter-spacing: 0.15em;
				text-transform: uppercase;
				color: var(--accent);
			}
			.hero h1 {
				margin-bottom: 0.6em;
			}
			.hero .positioning {
				font-size: 1.1em;
				color: var(--text-primary);
			}
			.cta-links {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.75em;
				margin-top: 1.75em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">Amul Bham</p>
				<h1>Applied research on AI systems, SEO architecture, systems design, and policy systems.</h1>
				<p class="positioning">
					I design and build systems at the intersection of AI infrastructure, information
					architecture, and technical SEO — and publish research on how those disciplines converge
					in production.
				</p>
				<nav class="cta-links" aria-label="Primary">
					<Button href="/research-hub" variant="primary">Browse Research Hub</Button>
					<Button href="/about" variant="secondary">About Amul</Button>
				</nav>
			</section>

			<RecentResearch />
		</main>
		<Footer />
	</body>
</html>
