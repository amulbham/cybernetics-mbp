---
import BaseHead from '../components/BaseHead.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import RecentResearch from '../components/RecentResearch.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SOCIAL_LINKS } from '../consts';
import { formatPillarLabel, PILLAR_DESCRIPTIONS } from '../lib/pillars';

// Category navigation, not a content listing — shown unconditionally for all
// 4 pillars regardless of how many papers each currently has (unlike
// research/index.astro's category sections, which only render once a pillar
// has at least one paper). An empty pillar is still a legitimate place to
// browse to, the same way nav links don't disappear when a section is thin.
const pillars = Object.keys(PILLAR_DESCRIPTIONS);

// Homepage entity graph: establishes Amul Bham as a disambiguated Person
// entity (linked to LinkedIn/Substack/GitHub/ORCID via the same SOCIAL_LINKS
// used in ResearchLayout.astro's author.sameAs) and the site itself as a
// WebSite entity, for crawler/LLM entity association — see AGENTS.md's
// "Content-section transforms" area for why SOCIAL_LINKS is the single
// source of truth these both draw from.
const personJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Amul Bham',
	url: new URL('/about', Astro.site).toString(),
	sameAs: Object.values(SOCIAL_LINKS),
};

const websiteJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	url: Astro.site?.toString(),
	author: { '@type': 'Person', name: 'Amul Bham' },
};

// Escape `<` so JSON-LD can't break out of the script tag — same guard as ResearchLayout.astro.
const personJsonLdString = JSON.stringify(personJsonLd).replace(/</g, '\\u003c');
const websiteJsonLdString = JSON.stringify(websiteJsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={personJsonLdString} />
		<script type="application/ld+json" set:html={websiteJsonLdString} />
		<style>
			main {
				width: var(--content-width-wide);
				max-width: calc(100% - 2em);
			}
			.hero {
				max-width: var(--content-width-prose);
				margin: 0 0 3.5em;
			}
			.hero .eyebrow {
				margin: 0 0 1em;
				font-family: var(--font-mono);
				font-size: 0.85em;
				letter-spacing: 0.15em;
				text-transform: uppercase;
				color: var(--accent);
			}
			.hero h1 {
				margin-bottom: 0.6em;
			}
			.hero .positioning {
				font-size: 1.1em;
				color: var(--text-secondary);
			}
			.cta-links {
				display: flex;
				flex-wrap: wrap;
				justify-content: flex-start;
				gap: 0.75em;
				margin-top: 1.75em;
			}
			.section-label {
				font-family: var(--font-mono);
				font-size: var(--text-xs);
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: var(--text-secondary);
				margin-bottom: var(--space-5);
			}
			.pillars-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: var(--space-4);
				margin-bottom: var(--space-7);
				list-style: none;
				padding: 0;
			}
			@media (max-width: 640px) {
				.pillars-grid {
					grid-template-columns: 1fr;
				}
			}
			.pillar-card {
				display: block;
				border: 1px solid var(--border);
				border-radius: var(--radius-md);
				padding: var(--space-5);
				text-decoration: none;
				color: inherit;
				transition: border-color 0.15s ease;
			}
			.pillar-card:hover,
			.pillar-card:focus-visible {
				border-color: var(--accent);
			}
			.pillar-dot {
				width: 8px;
				height: 8px;
				border-radius: 50%;
				margin-bottom: var(--space-3);
			}
			.pillar-card h3 {
				font-size: var(--text-base);
				margin: 0 0 var(--space-2);
			}
			.pillar-card p {
				font-size: var(--text-sm);
				color: var(--text-secondary);
				margin: 0;
				line-height: 1.5;
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<section class="hero">
				<p class="eyebrow">Amul Bham</p>
				<h1>Applied research on AI systems, SEO architecture, systems design, and policy systems.</h1>
				<p class="positioning">
					I design and build systems at the intersection of AI infrastructure, information
					architecture, and technical SEO — and publish research on how those disciplines converge
					in production.
				</p>
				<nav class="cta-links" aria-label="Primary">
					<Button href="/research" variant="primary">Browse research</Button>
					<Button href="/about" variant="secondary">About Amul</Button>
				</nav>
			</section>

			<RecentResearch />

			<div>
				<p class="section-label">Research pillars</p>
				<ul class="pillars-grid">
					{
						pillars.map((pillar) => (
							<li>
								<a class="pillar-card" href={`/research/${pillar}/`}>
									<span class="pillar-dot" style={`background: var(--pillar-${pillar})`} />
									<h3>{formatPillarLabel(pillar)}</h3>
									<p>{PILLAR_DESCRIPTIONS[pillar]}</p>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</main>
		<Footer />
	</body>
</html>
