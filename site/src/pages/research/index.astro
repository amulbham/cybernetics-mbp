---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Card from '../../components/Card.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { formatPillarLabel } from '../../lib/pillars';

const entries = await getCollection('research');
const papers = entries.filter((entry) => entry.data.format === 'paper');

const pillars = [...new Set(papers.map((paper) => paper.data.pillar!))].sort();
const pillarGroups = pillars.map((pillar) => ({
	category: pillar,
	label: formatPillarLabel(pillar),
	entries: papers
		.filter((paper) => paper.data.pillar === pillar)
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
}));

// Essays/memos sections only show up here once they have at least one entry
// (same convention as pillar sections) — the dedicated /research/essays/
// and /research/memos/ pages always exist regardless, with an empty
// state, since those are fixed taxonomy categories rather than ad-hoc pillars.
const formatGroups = (['essay', 'memo'] as const)
	.map((format) => ({
		category: `${format}s`,
		label: format === 'essay' ? 'Essays' : 'Memos',
		entries: entries
			.filter((entry) => entry.data.format === format)
			.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
	}))
	.filter((group) => group.entries.length > 0);

const categoryGroups = [...pillarGroups, ...formatGroups];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Research"
			description="Research from Amul Bham — papers organized by pillar, plus longer essays and shorter memos."
		/>
		<style>
			main {
				width: var(--content-width-wide);
				max-width: calc(100% - 2em);
			}
			.intro {
				margin-bottom: 2.5em;
				color: var(--text-primary);
			}
			.category-section {
				margin-bottom: 3em;
			}
			.category-section h2 {
				border-bottom: 1px solid var(--border);
				padding-bottom: 0.3em;
			}
			.category-section h2 a {
				color: inherit;
				text-decoration: none;
			}
			.category-section h2 a:hover {
				color: var(--accent);
			}
			.entries {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1.5em;
				list-style: none;
				margin: 1em 0 0;
				padding: 0;
			}
			.entries h3 {
				margin: 0.6em 0 0.4em;
				font-size: 1.2em;
				color: var(--card-hover-color, var(--text-primary));
				transition: color 0.15s ease;
			}
			.entries p {
				margin: 0;
				color: var(--text-primary);
				font-size: 0.95em;
			}
			.empty {
				color: var(--text-secondary);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Research</h1>
			<p class="intro">Papers, essays, and memos — each links to a dedicated write-up with full citation metadata.</p>
			{categoryGroups.length === 0 && <p class="empty">No research published yet — check back soon.</p>}
			{
				categoryGroups.map(({ category, label, entries }) => (
					<section class="category-section" id={category}>
						<h2>
							<a href={`/research/${category}/`}>{label}</a>
						</h2>
						<ul class="entries">
							{entries.map((entry) => (
								<Card href={`/research/${category}/${entry.id}/`}>
									<span class="meta">
										<FormattedDate date={entry.data.pubDate} />
									</span>
									<h3>{entry.data.title}</h3>
									<p>{entry.data.excerpt}</p>
								</Card>
							))}
						</ul>
					</section>
				))
			}
		</main>
		<Footer />
	</body>
</html>
