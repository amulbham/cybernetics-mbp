---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Card from '../../components/Card.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { CATEGORIES } from '../../lib/categories';
import { canonicalPath, categoryPath } from '../../lib/research-routing';

const entries = await getCollection('research');

// One section per registered category, in registry order — scholarly papers
// and commentary sit together under the category they were placed in (so
// Essays appears once). A category only gets a section here once it has at
// least one entry (same convention as before); every category's landing page
// at /research/{category}/ exists regardless, with an empty state.
const categoryGroups = CATEGORIES.map((category) => ({
	category: category.slug,
	label: category.label,
	entries: entries
		.filter((entry) => entry.data.category === category.slug)
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
})).filter((group) => group.entries.length > 0);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Research"
			description="Research from Amul Bham — organized by category: Cybernetics, Knowledge Work, AI Systems, and Essays."
		/>
		<style>
			main {
				width: var(--content-width-wide);
				max-width: calc(100% - 2em);
			}
			.intro {
				margin-bottom: 2.5em;
				color: var(--text-primary);
			}
			.category-section {
				margin-bottom: 3em;
			}
			.category-section h2 {
				border-bottom: 1px solid var(--border);
				padding-bottom: 0.3em;
			}
			.category-section h2 a {
				color: inherit;
				text-decoration: none;
			}
			.category-section h2 a:hover {
				color: var(--accent);
			}
			.entries {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1.5em;
				list-style: none;
				margin: 1em 0 0;
				padding: 0;
			}
			.entries h3 {
				margin: 0.6em 0 0.4em;
				font-size: 1.2em;
				color: var(--card-hover-color, var(--text-primary));
				transition: color 0.15s ease;
			}
			.entries p {
				margin: 0;
				color: var(--text-primary);
				font-size: 0.95em;
			}
			.empty {
				color: var(--text-secondary);
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<h1>Research</h1>
			<p class="intro">Papers, essays, and memos — each links to a dedicated write-up with full citation metadata.</p>
			{categoryGroups.length === 0 && <p class="empty">No research published yet — check back soon.</p>}
			{
				categoryGroups.map(({ category, label, entries }) => (
					<section class="category-section" id={category}>
						<h2>
							<a href={categoryPath(category)}>{label}</a>
						</h2>
						<ul class="entries">
							{entries.map((entry) => (
								<Card href={canonicalPath(entry)}>
									<span class="meta">
										<FormattedDate date={entry.data.pubDate} />
									</span>
									<h3>{entry.data.title}</h3>
									<p>{entry.data.excerpt}</p>
								</Card>
							))}
						</ul>
					</section>
				))
			}
		</main>
		<Footer />
	</body>
</html>
