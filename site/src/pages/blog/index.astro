---
import BaseHead from '../../components/BaseHead.astro';
import Card from '../../components/Card.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Blog"
			description="Essays and shorter pieces from Amul Bham, alongside the formal research in the Research Hub."
		/>
		<style>
			main {
				width: var(--content-width-wide);
				max-width: calc(100% - 2em);
			}
			.intro {
				color: var(--text-primary);
				margin-bottom: 2.5em;
			}
			.entries {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1.5em;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.entries h3 {
				margin: 0.6em 0 0.4em;
				font-size: 1.2em;
				color: var(--card-hover-color, var(--text-primary));
				transition: color 0.15s ease;
			}
			.entries p {
				margin: 0;
				color: var(--text-primary);
				font-size: 0.95em;
			}
			.empty {
				color: var(--text-secondary);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Blog</h1>
			<p class="intro">Essays and shorter pieces — the formal research lives in the Research Hub.</p>
			{
				posts.length > 0 ? (
					<ul class="entries">
						{posts.map((post) => (
							<Card href={`/blog/${post.id}/`}>
								<span class="meta">
									<FormattedDate date={post.data.pubDate} />
								</span>
								<h3>{post.data.title}</h3>
								<p>{post.data.excerpt}</p>
							</Card>
						))}
					</ul>
				) : (
					<p class="empty">No posts published yet — check back soon.</p>
				)
			}
		</main>
		<Footer />
	</body>
</html>
