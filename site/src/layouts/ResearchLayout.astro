---
import { Image } from 'astro:assets';
import { getEntry, type CollectionEntry } from 'astro:content';
import ArticleMasthead from '../components/ArticleMasthead.astro';
import AuthorNote from '../components/AuthorNote.astro';
import Badge from '../components/Badge.astro';
import BaseHead from '../components/BaseHead.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedResearch from '../components/RelatedResearch.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { AUTHOR, LICENSE } from '../consts';
import relationsRaw from '../data/research-relations.json';
import projectionsRaw from '../data/research-relation-projections.json';
import { relationsSchema } from '../lib/research-relations';
import {
	outgoingProjectionsFor,
	projectionsJsonLd,
	projectionsSchema,
	type ProjectionProperty,
} from '../lib/research-relation-projections';
import { canonicalPath, categoryLabelFromSegment, categorySegment } from '../lib/research-routing';
import { personIdentity } from '../lib/structured-data';
import { slugifyTag } from '../lib/tags';
import ArticleShell from './ArticleShell.astro';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

type Props = CollectionEntry<'research'>['data'] & {
	id: string;
	minutesRead?: number;
	wordCount?: number;
	headings: Heading[];
};

const {
	title,
	subtitle,
	description,
	excerpt,
	format,
	pubDate,
	dateModified,
	tags,
	doi,
	pillar,
	id,
	minutesRead,
	wordCount,
	headings,
	heroImage,
	heroImageAlt,
} = Astro.props;

const isPaper = format === 'paper';
const category = isPaper ? pillar! : `${format}s`;
const categoryLabel = categoryLabelFromSegment(category);
const categoryUrl = `/research/${category}/`;

// Derived, not frontmatter, so it can never drift from the entry's actual
// route (this previously happened: a paper's canonicalURL frontmatter still
// said `systems-architecture` after its `pillar` was changed to `policy-systems`).
const canonicalURL = new URL(`/research/${category}/${id}/`, Astro.site).toString();
const ogImagePath = `/open-graph/${category}/${id}.png`;
const ogImageUrl = new URL(ogImagePath, Astro.site).toString();

// The one paper-PDF identity (Sprint 8.4) — derived, never authored. No
// frontmatter field exists for this; every consumer (Highwire
// citation_pdf_url, the JSON-LD MediaObject, and the reader-facing Download
// PDF link) reads this same value, so there is exactly one URL a paper's
// PDF could ever be at. Same subdirectory as the HTML by construction,
// since canonicalURL always ends in a trailing slash. The PDF itself is
// produced by a separate, later build step (Sprint 8.2's
// build-research-pdfs.mjs, which runs after `astro build`) — this is a
// claim about where that file will be, not a check that it already exists,
// and must never become one (an fs.existsSync check here would run before
// the PDF does).
const paperPdfUrl = isPaper ? new URL('paper.pdf', canonicalURL).toString() : undefined;

// Sprint 11.2 — moved up from its old spot near the Highwire block so
// JSON-LD's `identifier` and Highwire's `citation_doi` can consume the
// exact same normalized value, never two independent derivations of the
// same fact. Bare identifier (Highwire convention, and now also
// PropertyValue.value) — strips the resolver prefix. The frontmatter
// field and the masthead's own DOI link both keep the full
// https://doi.org/... URL; only this one derived value is ever bare.
const normalizedDoi = doi?.replace(/^https?:\/\/doi\.org\//, '');

// Sprint 11.1's one canonical Person identity, reused for both roles
// below — author and publisher are the same real-world entity occupying
// two roles (direct self-publication), not two independent Person shapes
// (Sprint 11.2).
const canonicalPerson = personIdentity(Astro.site);

// Sprint 11.4 — the first real Schema.org projection of an approved
// research relation. src/data/research-relations.json stays the
// authoritative internal graph; src/data/research-relation-projections.json
// is the separate, explicit editorial decision about which one canonical
// edge gets to surface as which one standard property (see
// research-relation-projections.ts for the full contract). This is a
// defensive re-parse, not the primary gate — the same posture
// rehype-research-links.mjs already takes with the relations registry:
// Sprint 11.3's dedicated validator (npm run build's first step) already
// guarantees both files parse, are internally consistent, and every
// relationId/source/target resolves to a real entry before astro build
// ever runs.
const relations = relationsSchema.parse(relationsRaw);
const projections = projectionsSchema.parse(projectionsRaw);
const outgoingProjections = outgoingProjectionsFor(id, relations, projections);
const resolvedProjections: Array<{ property: ProjectionProperty; targetUrl: string }> = [];
for (const { property, targetId } of outgoingProjections) {
	const targetEntry = await getEntry('research', targetId);
	// Fail closed rather than silently omitting: the 11.3 validator already
	// guarantees this resolves in a healthy build, so reaching this throw
	// means the registries and the content collection have drifted apart
	// since that check ran — a real bug, never an expected state.
	if (!targetEntry) {
		throw new Error(`ResearchLayout: relation projection target "${targetId}" has no matching research entry`);
	}
	resolvedProjections.push({ property, targetUrl: new URL(canonicalPath(targetEntry), Astro.site).toString() });
}
// A spreadable partial: {} when this entry has zero approved outgoing
// projections, so `...relationProjections` below adds nothing at all —
// never an empty-array/null placeholder key.
const relationProjections = projectionsJsonLd(resolvedProjections);

const breadcrumbItems = [
	{ label: 'Home', href: '/' },
	{ label: 'Research', href: '/research' },
	{ label: categoryLabel, href: categoryUrl },
];

const jsonLd = {
	'@context': 'https://schema.org',
	// schema.org has no distinct "essay"/"memo" type — ScholarlyArticle is
	// reserved for papers specifically; everything else is a plain Article.
	'@type': isPaper ? ['ScholarlyArticle', 'Article'] : 'Article',
	headline: title,
	description,
	image: ogImageUrl,
	datePublished: pubDate.toISOString(),
	dateModified: (dateModified ?? pubDate).toISOString(),
	url: canonicalURL,
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': canonicalURL,
	},
	// isPartOf/articleSection link a paper to its pillar — essays/memos have
	// no pillar to link to, so this is paper-only.
	...(isPaper && {
		isPartOf: {
			'@type': 'CollectionPage',
			name: categoryLabel,
			url: new URL(categoryUrl, Astro.site).toString(),
		},
		articleSection: categoryLabel,
	}),
	keywords: tags.join(', '),
	inLanguage: 'en-US',
	license: LICENSE.url,
	...(wordCount && { wordCount }),
	...(minutesRead && { timeRequired: `PT${minutesRead}M` }),
	// Sprint 11.1 — the one canonical Person identity (src/lib/structured-data.ts),
	// not a hand-typed core. Article/WebPage/CollectionPage identity are all
	// explicitly untouched this sprint (Sprint 11.0 found none of them earned
	// additional graph structure) — only the author's Person core changed.
	author: canonicalPerson,
	// Sprint 11.2 — direct self-publication: the same canonical Person
	// occupies both roles. Applies to every format (paper/essay/memo) via
	// this one shared layout, not gated on isPaper — publisher follows the
	// real publication model, not this site's local content taxonomy.
	publisher: canonicalPerson,
	// Sprint 11.2 — a DOI identifies a research object independently of
	// paper|essay|memo; gated on normalizedDoi presence alone, never on
	// isPaper (a future DOI-bearing essay could get this without acquiring
	// any paper-only feature). Today only Invariants has one. Absence is
	// part of the contract: no doi → no identifier, never a null/empty one.
	...(normalizedDoi && {
		identifier: {
			'@type': 'PropertyValue',
			propertyID: 'DOI',
			value: normalizedDoi,
		},
	}),
	...(isPaper &&
		paperPdfUrl && {
			encoding: {
				'@type': 'MediaObject',
				contentUrl: paperPdfUrl,
				encodingFormat: 'application/pdf',
			},
		}),
	// Sprint 11.4 — the projected form of this entry's approved outgoing
	// research relation(s), if any. Source-only (this object is always the
	// relation's `source`; a target never gets a reciprocal property here —
	// see research-relation-projections.ts) and additive: every other
	// Article property above is unaffected by whether this entry has zero
	// or one approved outgoing edge.
	...relationProjections,
};

const breadcrumbJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		...breadcrumbItems.map((item, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			name: item.label,
			item: new URL(item.href, Astro.site).toString(),
		})),
		{
			'@type': 'ListItem',
			position: breadcrumbItems.length + 1,
			name: title,
			item: canonicalURL,
		},
	],
};

// Escape `<` so a value like `</script>` in frontmatter can't break out of the JSON-LD blocks.
const jsonLdString = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
const breadcrumbJsonLdString = JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c');

// Highwire Press tags (Sprint 8.3), papers only — a second, separate
// metadata vocabulary Google Scholar's own indexer reads directly rather
// than parsing JSON-LD. Additive: JSON-LD above is unchanged and stays the
// primary structured-data source for everything else. citation_pdf_url
// reuses paperPdfUrl (see above) — never its own derivation.

// YYYY/MM/DD, Scholar's slash form — read with UTC getters, not local-time
// ones. pubDate comes from z.coerce.date() on a date-only frontmatter
// string ("2026-08-24"), which JS parses as UTC midnight; local-time
// getters would silently read back the *previous* calendar day in any
// timezone behind UTC (this machine's own PDT included).
const citationPublicationDate = isPaper
	? `${pubDate.getUTCFullYear()}/${String(pubDate.getUTCMonth() + 1).padStart(2, '0')}/${String(pubDate.getUTCDate()).padStart(2, '0')}`
	: undefined;
---

<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={excerpt}
			image={ogImagePath}
			article={{
				publishedTime: pubDate.toISOString(),
				modifiedTime: dateModified?.toISOString(),
				tags,
			}}
		/>
		<script type="application/ld+json" set:html={jsonLdString} />
		<script type="application/ld+json" set:html={breadcrumbJsonLdString} />
			{
				isPaper && (
					<>
						<meta name="citation_title" content={title} />
						<meta name="citation_author" content={AUTHOR.name} />
						<meta name="citation_publication_date" content={citationPublicationDate} />
						<meta name="citation_pdf_url" content={paperPdfUrl} />
						{normalizedDoi && <meta name="citation_doi" content={normalizedDoi} />}
					</>
				)
			}
		<style>
			.tags {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.5em;
				margin: 0 0 1em;
				padding: 0;
				list-style: none;
			}
			.tags a {
				text-decoration: none;
			}
			.tags a:hover :global(.badge),
			.tags a:focus-visible :global(.badge) {
				background-color: var(--border);
			}
			.pdf-link {
				margin-bottom: 1em;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow-lg);
			}
		</style>
	</head>

	<body>
		<ArticleShell
			title={title}
			subtitle={subtitle}
			pubDate={pubDate}
			updatedDate={dateModified}
			minutesRead={minutesRead}
		>
			<Fragment slot="hero">
				{
					heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt={heroImageAlt ?? ''} />
						</div>
					)
				}
			</Fragment>
			<Fragment slot="before-title">
				<Breadcrumbs items={breadcrumbItems} />
			</Fragment>
			<Fragment slot="after-title">
				<ArticleMasthead format={format} doi={doi} />
				{
					tags.length > 0 && (
						<ul class="tags">
							{tags.map((tag) => (
								<li>
									<a href={`/tags/${slugifyTag(tag)}/`}>
										<Badge variant="neutral">{tag}</Badge>
									</a>
								</li>
							))}
						</ul>
					)
				}
				{
					isPaper && paperPdfUrl && (
						<p class="pdf-link">
							<a href={paperPdfUrl}>Download PDF</a>
						</p>
					)
				}
			</Fragment>
			<Fragment slot="mobile-toc">
				<TableOfContents headings={headings} variant="mobile" />
			</Fragment>
			<Fragment slot="toc">
				<TableOfContents headings={headings} variant="rail" />
			</Fragment>
			<slot />
			<AuthorNote />
			<RelatedResearch currentId={id} pillar={pillar} tags={tags} />
		</ArticleShell>
	</body>
</html>
