---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Badge from '../components/Badge.astro';
import BaseHead from '../components/BaseHead.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedPapers from '../components/RelatedPapers.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { SOCIAL_LINKS } from '../consts';
import { formatPillarLabel } from '../lib/pillars';
import { slugifyTag } from '../lib/tags';
import ArticleShell from './ArticleShell.astro';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

type Props = CollectionEntry<'papers'>['data'] & {
	id: string;
	minutesRead?: number;
	wordCount?: number;
	headings: Heading[];
};

const {
	title,
	description,
	pubDate,
	dateModified,
	tags,
	pdfUrl,
	pillar,
	id,
	minutesRead,
	wordCount,
	headings,
	heroImage,
	heroImageAlt,
} = Astro.props;
const pillarLabel = formatPillarLabel(pillar);
const pillarUrl = `/research-hub/${pillar}/`;
// Derived, not frontmatter, so it can never drift from the paper's actual
// route (this previously happened: a paper's canonicalURL frontmatter still
// said `systems-architecture` after its `pillar` was changed to `policy-systems`).
const canonicalURL = new URL(`/research-hub/${pillar}/${id}/`, Astro.site).toString();
const ogImagePath = `/open-graph/${pillar}/${id}.png`;
const ogImageUrl = new URL(ogImagePath, Astro.site).toString();

const breadcrumbItems = [
	{ label: 'Research Hub', href: '/research-hub' },
	{ label: pillarLabel, href: pillarUrl },
];

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': ['ScholarlyArticle', 'Article'],
	headline: title,
	description,
	image: ogImageUrl,
	datePublished: pubDate.toISOString(),
	dateModified: (dateModified ?? pubDate).toISOString(),
	url: canonicalURL,
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': canonicalURL,
	},
	isPartOf: {
		'@type': 'CollectionPage',
		name: pillarLabel,
		url: new URL(pillarUrl, Astro.site).toString(),
	},
	articleSection: pillarLabel,
	keywords: tags.join(', '),
	inLanguage: 'en-US',
	...(wordCount && { wordCount }),
	...(minutesRead && { timeRequired: `PT${minutesRead}M` }),
	author: {
		'@type': 'Person',
		name: 'Amul Bham',
		url: new URL('/about', Astro.site),
		sameAs: Object.values(SOCIAL_LINKS),
	},
	...(pdfUrl && {
		encoding: {
			'@type': 'MediaObject',
			contentUrl: pdfUrl,
			encodingFormat: 'application/pdf',
		},
	}),
};

const breadcrumbJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		...breadcrumbItems.map((item, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			name: item.label,
			item: new URL(item.href, Astro.site).toString(),
		})),
		{
			'@type': 'ListItem',
			position: breadcrumbItems.length + 1,
			name: title,
			item: canonicalURL,
		},
	],
};

// Escape `<` so a value like `</script>` in frontmatter can't break out of the JSON-LD blocks.
const jsonLdString = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
const breadcrumbJsonLdString = JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c');
---

<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={ogImagePath}
			article={{
				publishedTime: pubDate.toISOString(),
				modifiedTime: dateModified?.toISOString(),
				tags,
			}}
		/>
		<script type="application/ld+json" set:html={jsonLdString} />
		<script type="application/ld+json" set:html={breadcrumbJsonLdString} />
		<style>
			.tags {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.5em;
				margin: 0 0 1em;
				padding: 0;
				list-style: none;
			}
			.tags a {
				text-decoration: none;
			}
			.tags a:hover :global(.badge),
			.tags a:focus-visible :global(.badge) {
				background-color: var(--border);
			}
			.pdf-link {
				margin-bottom: 1em;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow-lg);
			}
		</style>
	</head>

	<body>
		<ArticleShell title={title} pubDate={pubDate} updatedDate={dateModified} minutesRead={minutesRead}>
			<Fragment slot="hero">
				{
					heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt={heroImageAlt ?? ''} />
						</div>
					)
				}
			</Fragment>
			<Fragment slot="before-title">
				<Breadcrumbs items={breadcrumbItems} />
			</Fragment>
			<Fragment slot="after-title">
				{
					tags.length > 0 && (
						<ul class="tags">
							{tags.map((tag) => (
								<li>
									<a href={`/tags/${slugifyTag(tag)}/`}>
										<Badge variant="neutral">{tag}</Badge>
									</a>
								</li>
							))}
						</ul>
					)
				}
				{
					pdfUrl && (
						<p class="pdf-link">
							<a href={pdfUrl}>Download PDF</a>
						</p>
					)
				}
			</Fragment>
			<Fragment slot="mobile-toc">
				<TableOfContents headings={headings} variant="mobile" />
			</Fragment>
			<Fragment slot="toc">
				<TableOfContents headings={headings} variant="rail" />
			</Fragment>
			<slot />
			<RelatedPapers currentId={id} pillar={pillar} tags={tags} />
		</ArticleShell>
	</body>
</html>
