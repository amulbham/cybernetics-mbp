---
// Shared body shell for long-form article layouts (PaperLayout, BlogPost):
// Header + title/date block + prose container + Footer. Each layout still
// owns its own <html><head> (they need different BaseHead/JSON-LD calls) and
// projects layout-specific pieces (breadcrumb, tags, hero image) into the
// named slots below.
import FormattedDate from '../components/FormattedDate.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ScrollProgress from '../components/ScrollProgress.astro';

interface Props {
	title: string;
	pubDate: Date;
	updatedDate?: Date;
	minutesRead?: number;
}

const { title, pubDate, updatedDate, minutesRead } = Astro.props;
---

<ScrollProgress />
<Header />
<main>
	<article>
		<slot name="hero" />
		<div class="article-body">
			<div class="prose">
				<div class="title">
					<slot name="before-title" />
					<div class="date meta">
						<FormattedDate date={pubDate} />
						{minutesRead && <span> · {minutesRead} min read</span>}
						{
							updatedDate && (
								<div class="last-updated-on">
									Last updated on <FormattedDate date={updatedDate} />
								</div>
							)
						}
					</div>
					<h1>{title}</h1>
					<slot name="after-title" />
					<hr />
				</div>
				<slot name="mobile-toc" />
				<slot />
			</div>
			<slot name="toc" />
		</div>
	</article>
</main>
<Footer />

<style>
	main {
		width: calc(100% - 2em);
		max-width: 100%;
		margin: 0;
	}
	.article-body {
		display: flex;
		justify-content: center;
		align-items: flex-start;
		gap: 3em;
	}
	.prose {
		width: var(--content-width-prose);
		max-width: calc(100% - 2em);
		margin: 0;
		padding: 1em;
		color: var(--text-primary);
	}
	.title {
		margin-bottom: 1em;
		padding: 1em 0;
		text-align: center;
		line-height: 1;
	}
	.title h1 {
		margin: 0 0 0.5em 0;
	}
	.date {
		margin-bottom: 0.5em;
	}
	.last-updated-on {
		font-style: italic;
	}
</style>

<script is:inline>
	// Lives here, not in TableOfContents.astro, because PaperLayout renders
	// that component twice (variant="mobile" + "rail") — a script inside a
	// twice-rendered component runs twice. ArticleShell renders exactly once
	// per page, so this initializes exactly once regardless of how many TOC
	// variants are on the page. No-ops harmlessly on BlogPost pages, which
	// don't render a TableOfContents at all (both querySelectorAll calls just
	// return empty).
	//
	// astro:page-load (not DOMContentLoaded) so this also re-initializes when
	// a View Transitions client-side navigation lands on a paper page — the
	// TOC rail and article body are both swapped, so any previous observer
	// and its element references are stale.
	(function () {
		var observer;
		function initToc() {
			// 1. Mobile TOC: automatically collapse <details> when a section link is tapped
			var mobileDetails = document.querySelector('[data-toc-mobile]');
			var mobileLinks = document.querySelectorAll('[data-toc-mobile-link]');
			if (mobileDetails && mobileLinks.length > 0) {
				mobileLinks.forEach(function (link) {
					link.addEventListener('click', function () {
						mobileDetails.removeAttribute('open');
					});
				});
			}

			// 2. Desktop TOC rail scroll-spy
			if (observer) observer.disconnect();
			var links = document.querySelectorAll('[data-toc-link]');
			if (links.length === 0) return;
			var headings = [];
			links.forEach(function (link) {
				var slug = link.getAttribute('data-toc-link');
				var heading = slug && document.getElementById(slug);
				if (heading) headings.push({ heading: heading, link: link });
			});
			if (headings.length === 0) return;

			function setActive(activeLink) {
				links.forEach(function (l) {
					l.classList.toggle('active', l === activeLink);
				});
			}

			observer = new IntersectionObserver(
				function (entries) {
					var visible = entries.filter(function (e) {
						return e.isIntersecting;
					});
					if (visible.length === 0) return;
					var topmost = visible.reduce(function (a, b) {
						return a.boundingClientRect.top < b.boundingClientRect.top ? a : b;
					});
					var match = headings.find(function (h) {
						return h.heading === topmost.target;
					});
					if (match) setActive(match.link);
				},
				{ rootMargin: '0px 0px -70% 0px', threshold: 0 }
			);
			headings.forEach(function (h) {
				observer.observe(h.heading);
			});
		}
		document.addEventListener('astro:page-load', initToc);
	})();
</script>
