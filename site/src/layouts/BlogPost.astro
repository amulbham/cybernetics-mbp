---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import ArticleShell from './ArticleShell.astro';

type Props = CollectionEntry<'blog'>['data'] & { minutesRead?: number };

const { title, description, pubDate, updatedDate, heroImage, minutesRead } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow-lg);
			}
		</style>
	</head>

	<body>
		<ArticleShell title={title} pubDate={pubDate} updatedDate={updatedDate} minutesRead={minutesRead}>
			<Fragment slot="hero">
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
			</Fragment>
			<slot />
		</ArticleShell>
	</body>
</html>
